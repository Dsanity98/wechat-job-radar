<view class="page">
  <block wx:if="{{job}}">
    <view class="hero card">
      <view class="hero__top">
        <text class="badge badge-{{job.status}}">{{job.statusLabel}}</text>
        <text class="deadline {{job.deadlineWarn ? 'deadline--warn' : ''}}" wx:if="{{job.deadlineText}}">截止 {{job.deadlineText}}</text>
      </view>
      <view class="title">{{job.title}}</view>
      <view class="company">{{job.company}}</view>
      <view class="meta">
        <text wx:if="{{job.city}}">{{job.city}}</text>
        <text class="sep" wx:if="{{job.city && job.typeLabel}}">·</text>
        <text wx:if="{{job.typeLabel}}">{{job.typeLabel}}</text>
        <text class="sep" wx:if="{{(job.city || job.typeLabel) && job.category}}">·</text>
        <text wx:if="{{job.category}}">{{job.category}}</text>
      </view>
    </view>

    <view class="section card">
      <view class="section__title">投递状态</view>
      <view class="status-row">
        <view
          class="status status-{{item.key}} {{job.status === item.key ? 'status--active' : ''}}"
          wx:for="{{statusList}}"
          wx:key="key"
          data-status="{{item.key}}"
          bindtap="setStatus"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="section card" wx:if="{{job.daysHint}}">
      <view class="info-row">
        <text class="info-label">截止提醒</text>
        <text class="info-value {{job.daysHint === '已截止' ? 'warn' : ''}}">{{job.daysHint}}</text>
      </view>
    </view>

    <view class="section card" wx:if="{{job.note}}">
      <view class="section__title">备注</view>
      <text class="body" user-select>{{job.note}}</text>
    </view>

    <view class="section card" wx:if="{{job.description}}">
      <view class="section__title">岗位职责</view>
      <text class="body" user-select>{{job.description}}</text>
    </view>

    <view class="section card" wx:if="{{job.requirements}}">
      <view class="section__title">任职要求</view>
      <text class="body" user-select>{{job.requirements}}</text>
    </view>

    <view class="section card" wx:if="{{job.applyUrl}}">
      <view class="section__title">投递链接</view>
      <view class="link-row">
        <text class="link ellipsis" user-select>{{job.applyUrl}}</text>
        <button class="btn btn-ghost link-btn" bindtap="copyLink">复制</button>
      </view>
    </view>

    <view class="section card" wx:if="{{job.source}}">
      <view class="info-row">
        <text class="info-label">来源</text>
        <text class="info-value">{{job.source}}</text>
      </view>
    </view>

    <view class="actions">
      <button class="btn btn-ghost action" bindtap="edit">编辑</button>
      <button class="btn btn-danger action" bindtap="remove">删除</button>
    </view>
  </block>

  <view class="empty" wx:else>
    <view class="empty__title">岗位不存在</view>
    <view class="empty__desc">它可能已经被删除</view>
  </view>
</view>
