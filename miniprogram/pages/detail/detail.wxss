.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
}

.hero__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.deadline {
  font-size: 24rpx;
  color: #596579;
}

.deadline--warn {
  color: #b42318;
  font-weight: 600;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #17202c;
  line-height: 1.3;
}

.company {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #596579;
}

.meta {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  font-size: 26rpx;
  color: #8a94a3;
}

.sep {
  color: #c8cfd8;
}

.section {
  margin-top: 20rpx;
}

.section__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #17202c;
  margin-bottom: 16rpx;
}

.status-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.status {
  font-size: 26rpx;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  background: #f1f4f8;
  color: #596579;
  border: 2rpx solid transparent;
}

.status-pending {
  color: #2459d3;
  background: #eaf0ff;
}

.status-applied {
  color: #157347;
  background: #e7f5ee;
}

.status-interview {
  color: #b45309;
  background: #fdf1e3;
}

.status-offer {
  color: #7c3aed;
  background: #f3e8ff;
}

.status-closed {
  color: #596579;
  background: #eef1f5;
}

.status--active.status-pending {
  border-color: #2459d3;
  font-weight: 700;
}

.status--active.status-applied {
  border-color: #157347;
  font-weight: 700;
}

.status--active.status-interview {
  border-color: #b45309;
  font-weight: 700;
}

.status--active.status-offer {
  border-color: #7c3aed;
  font-weight: 700;
}

.status--active.status-closed {
  border-color: #596579;
  font-weight: 700;
}

.body {
  font-size: 28rpx;
  color: #344054;
  line-height: 1.75;
  white-space: pre-line;
}

.info-row {
  display: flex;
  gap: 24rpx;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.info-label {
  width: 160rpx;
  flex-shrink: 0;
  color: #8a94a3;
}

.info-value {
  flex: 1;
  color: #17202c;
  word-break: break-all;
}

.info-value.warn {
  color: #b42318;
  font-weight: 600;
}

.link-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.link {
  flex: 1;
  font-size: 26rpx;
  color: #2459d3;
}

.link-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.action {
  flex: 1;
}

.empty {
  padding: 120rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #17202c;
  margin-bottom: 12rpx;
}

.empty__desc {
  font-size: 26rpx;
  color: #8a94a3;
}
