.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
}

.demo-banner {
  background: #fdf1e3;
  color: #b45309;
  font-size: 24rpx;
  line-height: 1.5;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.hero__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.type {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.type-campus {
  color: #2459d3;
  background: #eaf0ff;
}

.type-intern {
  color: #157347;
  background: #e7f5ee;
}

.type-social {
  color: #b45309;
  background: #fdf1e3;
}

.deadline {
  font-size: 24rpx;
  color: #596579;
}

.deadline--warn {
  color: #b42318;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #17202c;
  line-height: 1.3;
}

.company {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #596579;
}

.salary {
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #2459d3;
}

.meta {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  font-size: 26rpx;
  color: #8a94a3;
}

.sep {
  color: #c8cfd8;
}

.tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  font-size: 22rpx;
  color: #2459d3;
  background: #eaf0ff;
  border-radius: 6rpx;
  padding: 4rpx 10rpx;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin: 24rpx 0;
}

.action {
  flex: 1;
}

.section {
  margin-bottom: 20rpx;
}

.section__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #17202c;
  margin-bottom: 16rpx;
}

.body {
  font-size: 28rpx;
  color: #344054;
  line-height: 1.75;
  white-space: pre-line;
}

.info-row {
  display: flex;
  gap: 24rpx;
  padding: 12rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f0f2f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 160rpx;
  flex-shrink: 0;
  color: #8a94a3;
}

.info-value {
  flex: 1;
  color: #17202c;
  word-break: break-all;
}

.info-value.link {
  color: #2459d3;
}

.empty-btn {
  margin-top: 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 40rpx;
}

.loading {
  text-align: center;
  padding: 80rpx 0;
}
