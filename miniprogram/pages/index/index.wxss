.page {
  min-height: 100vh;
  padding-bottom: 160rpx;
}

.head {
  padding: 28rpx 24rpx 12rpx;
}

.brand {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.brand__title {
  font-size: 40rpx;
  font-weight: 700;
  color: #17202c;
}

.brand__sub {
  font-size: 24rpx;
  color: #8a94a3;
}

.stats {
  display: flex;
  gap: 16rpx;
}

.stat {
  flex: 1;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(23, 32, 44, 0.04);
}

.stat--active {
  background: #eaf0ff;
}

.stat__num {
  font-size: 36rpx;
  font-weight: 700;
  color: #17202c;
}

.stat--active .stat__num {
  color: #2459d3;
}

.stat__label {
  font-size: 22rpx;
  color: #8a94a3;
}

.tabs {
  white-space: nowrap;
  padding: 16rpx 24rpx 4rpx;
}

.tab {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  font-size: 28rpx;
  color: #596579;
  background: #ffffff;
  border-radius: 999rpx;
  margin-right: 12rpx;
}

.tab--active {
  background: #2459d3;
  color: #ffffff;
  font-weight: 600;
}

.list {
  padding: 12rpx 24rpx 0;
}

.job {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(23, 32, 44, 0.04);
}

.job__top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.job__company {
  flex: 1;
  font-size: 24rpx;
  color: #596579;
}

.job__title {
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #17202c;
  line-height: 1.35;
}

.job__meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a94a3;
}

.sep {
  margin: 0 6rpx;
  color: #c8cfd8;
}

.job__foot {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: #596579;
}

.deadline--warn {
  color: #b42318;
  font-weight: 600;
}

.note {
  flex: 1;
  color: #8a94a3;
}

.empty {
  padding: 120rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #17202c;
  margin-bottom: 12rpx;
}

.empty__desc {
  font-size: 26rpx;
  color: #8a94a3;
  margin-bottom: 32rpx;
}

.empty__actions {
  display: flex;
  gap: 20rpx;
}

.empty-btn {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 36rpx;
}

.footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 40rpx 24rpx 32rpx;
  font-size: 24rpx;
  color: #8a94a3;
}

.footer__link {
  color: #8a94a3;
}

.footer__sep {
  color: #c8cfd8;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(env(safe-area-inset-bottom) + 48rpx);
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #2459d3;
  color: #ffffff;
  font-size: 56rpx;
  line-height: 104rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(36, 89, 211, 0.35);
}
