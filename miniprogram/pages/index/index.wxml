<view class="page">
  <view class="head">
    <view class="brand">
      <text class="brand__title">求职进度</text>
      <text class="brand__sub">记录每一次投递</text>
    </view>
    <view class="stats">
      <view
        class="stat {{activeStatus === item.key ? 'stat--active' : ''}}"
        wx:for="{{statCards}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onStatTap"
      >
        <text class="stat__num">{{stats[item.key]}}</text>
        <text class="stat__label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <scroll-view class="tabs" scroll-x="{{true}}">
    <view
      class="tab {{activeStatus === item.key ? 'tab--active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onStatusTap"
    >{{item.label}}</view>
  </scroll-view>

  <view class="list">
    <block wx:if="{{jobs.length}}">
      <view class="job" wx:for="{{jobs}}" wx:key="id" data-id="{{item.id}}" bindtap="onJobTap">
        <view class="job__top">
          <text class="badge badge-{{item.status}}">{{item.statusLabel}}</text>
          <text class="job__company ellipsis">{{item.company}}</text>
        </view>
        <view class="job__title">{{item.title}}</view>
        <view class="job__meta">
          <text wx:if="{{item.city}}">{{item.city}}</text>
          <text class="sep" wx:if="{{item.city && item.typeLabel}}">·</text>
          <text wx:if="{{item.typeLabel}}">{{item.typeLabel}}</text>
          <text class="sep" wx:if="{{(item.city || item.typeLabel) && item.category}}">·</text>
          <text wx:if="{{item.category}}">{{item.category}}</text>
        </view>
        <view class="job__foot">
          <text class="deadline {{item.expiring ? 'deadline--warn' : ''}}" wx:if="{{item.deadlineHint}}">{{item.deadlineHint}}</text>
          <text class="note ellipsis" wx:if="{{item.note}}">备注：{{item.note}}</text>
        </view>
      </view>
    </block>

    <view class="empty" wx:elif="{{!jobs.length}}">
      <view class="empty__title">还没有岗位记录</view>
      <view class="empty__desc">添加自己的求职岗位，或从参考库导入</view>
      <view class="empty__actions">
        <button class="btn btn-primary empty-btn" bindtap="addJob">添加岗位</button>
        <button class="btn btn-ghost empty-btn" bindtap="goLibrary">去参考库看看</button>
      </view>
    </view>
  </view>

  <view class="footer">
    <text class="footer__link" bindtap="goPrivacy">隐私政策</text>
    <text class="footer__sep">·</text>
    <text class="footer__link" bindtap="goTerms">用户协议与免责声明</text>
  </view>

  <view class="fab" bindtap="addJob">＋</view>
</view>
