<view class="page">
  <view class="form card">
    <view class="field">
      <text class="label">公司</text>
      <input class="input" placeholder="例如：字节跳动" value="{{company}}" data-field="company" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">岗位名称</text>
      <input class="input" placeholder="例如：后端开发实习生" value="{{title}}" data-field="title" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">类型</text>
      <picker mode="selector" range="{{typeOptions}}" value="{{typeIndex}}" bindchange="onTypeChange">
        <view class="picker-value">{{typeOptions[typeIndex]}}<view class="arrow"></view></view>
      </picker>
    </view>
    <view class="field">
      <text class="label">城市</text>
      <picker mode="selector" range="{{cityOptions}}" value="{{cityIndex}}" bindchange="onCityChange">
        <view class="picker-value">{{cityOptions[cityIndex]}}<view class="arrow"></view></view>
      </picker>
    </view>
    <view class="field">
      <text class="label">岗位方向</text>
      <picker mode="selector" range="{{categoryOptions}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker-value">{{categoryOptions[categoryIndex]}}<view class="arrow"></view></view>
      </picker>
    </view>
    <view class="field">
      <text class="label">截止日期</text>
      <picker mode="date" value="{{deadline}}" bindchange="onDeadlineChange">
        <view class="picker-value {{deadline ? '' : 'placeholder'}}">{{deadline || '选择截止日期'}}<view class="arrow"></view></view>
      </picker>
    </view>
    <view class="field">
      <text class="label">投递链接</text>
      <input class="input" placeholder="官网投递地址（选填）" value="{{applyUrl}}" data-field="applyUrl" bindinput="onInput" />
    </view>
    <view class="field field--textarea">
      <text class="label">备注</text>
      <textarea class="textarea" placeholder="面试安排、内推人、心得等（选填）" value="{{note}}" data-field="note" bindinput="onInput" maxlength="500" />
    </view>
  </view>

  <button class="btn btn-primary save-btn" bindtap="save">{{isEdit ? '保存修改' : '添加岗位'}}</button>
</view>
