.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
}

.form {
  padding: 8rpx 24rpx;
}

.field {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.field:last-child {
  border-bottom: none;
}

.field--textarea {
  align-items: flex-start;
}

.label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #596579;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #17202c;
}

.picker-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #17202c;
}

.picker-value.placeholder {
  color: #8a94a3;
}

.arrow {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid #8a94a3;
}

.textarea {
  flex: 1;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #17202c;
  line-height: 1.6;
}

.save-btn {
  margin-top: 32rpx;
}
