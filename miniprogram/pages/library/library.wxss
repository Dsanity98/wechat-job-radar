.page {
  min-height: 100vh;
  padding-bottom: 32rpx;
}

.hint {
  background: #eaf0ff;
  color: #2459d3;
  font-size: 24rpx;
  line-height: 1.5;
  padding: 12rpx 24rpx;
}

.head {
  padding: 24rpx 24rpx 8rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: #f1f4f8;
  border-radius: 999rpx;
  padding: 0 24rpx;
  height: 76rpx;
}

.search-icon {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #8a94a3;
  border-radius: 50%;
  position: relative;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.search-icon::after {
  content: "";
  position: absolute;
  width: 10rpx;
  height: 3rpx;
  background: #8a94a3;
  border-radius: 2rpx;
  transform: rotate(45deg);
  right: -8rpx;
  bottom: -6rpx;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #17202c;
}

.search-placeholder {
  color: #8a94a3;
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  color: #8a94a3;
  font-size: 32rpx;
}

.tabs {
  white-space: nowrap;
  padding: 8rpx 24rpx 0;
}

.tab {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  font-size: 28rpx;
  color: #596579;
  background: #ffffff;
  border-radius: 999rpx;
  margin-right: 12rpx;
}

.tab--active {
  background: #2459d3;
  color: #ffffff;
  font-weight: 600;
}

.filters {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx 8rpx;
}

.filter {
  background: #ffffff;
  border-radius: 999rpx;
  padding: 12rpx 20rpx;
}

.filter__inner {
  display: flex;
  align-items: center;
}

.filter__value {
  font-size: 26rpx;
  color: #17202c;
}

.filter__arrow {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid #8a94a3;
  margin-left: 10rpx;
}

.filter__count {
  font-size: 24rpx;
}

.filter__reset {
  font-size: 26rpx;
  color: #2459d3;
  margin-left: auto;
}

.list {
  padding: 8rpx 24rpx 0;
}

.empty-btn {
  margin-top: 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 40rpx;
}

.load-status {
  text-align: center;
  font-size: 24rpx;
  padding: 20rpx 0;
}
