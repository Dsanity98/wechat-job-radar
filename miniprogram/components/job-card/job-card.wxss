.job-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(23, 32, 44, 0.04);
}

.job-card--hover {
  background: #f7f9fc;
}

.top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #17202c;
  line-height: 1.35;
}

.salary {
  color: #2459d3;
  font-size: 30rpx;
  font-weight: 600;
  white-space: nowrap;
}

.company {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #596579;
}

.meta {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  font-size: 24rpx;
  color: #8a94a3;
}

.sep {
  color: #c8cfd8;
}

.tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  font-size: 22rpx;
  color: #2459d3;
  background: #eaf0ff;
  border-radius: 6rpx;
  padding: 4rpx 10rpx;
}

.foot {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: #8a94a3;
}

.type {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.type-campus {
  color: #2459d3;
  background: #eaf0ff;
}

.type-intern {
  color: #157347;
  background: #e7f5ee;
}

.type-social {
  color: #b45309;
  background: #fdf1e3;
}

.applied {
  font-size: 22rpx;
  font-weight: 600;
  color: #157347;
  background: #e7f5ee;
  border-radius: 6rpx;
  padding: 4rpx 10rpx;
}

.deadline--warn {
  color: #b42318;
}

.publish {
  margin-left: auto;
}

.demo {
  font-size: 22rpx;
  color: #8a94a3;
  border: 1rpx solid #e7ebf0;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}
